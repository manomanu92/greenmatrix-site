---
import { site, nav } from '../data/site.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => {
  const full = (base + href).replace(/\/$/, '') || '/';
  return current === full;
};
---

<header class="hdr" data-header>
  <div class="hdr__util">
    <div class="wrap hdr__util-in">
      <a href={site.phoneHref}>
        <svg viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"/></svg>
        {site.phone}
      </a>
      <a href={`mailto:${site.email}`}>
        <svg viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"/></svg>
        {site.email}
      </a>
      <span class="hdr__loc">
        <svg viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M172.268 501.67C26.97 291.031 0 269.413 0 192 0 85.961 85.961 0 192 0s192 85.961 192 192c0 77.413-26.97 99.031-172.268 309.67-9.535 13.774-29.93 13.773-39.464 0zM192 272c44.183 0 80-35.817 80-80s-35.817-80-80-80-80 35.817-80 80 35.817 80 80 80z"/></svg>
        {site.address}
      </span>
    </div>
  </div>

  <div class="wrap hdr__bar">
    <a href={base + '/'} class="hdr__brand" aria-label={`${site.name} — home`}>
      <img src={base + '/img/logo.png'} alt="" width="110" height="110" />
      <span>
        <strong>Green Matrix</strong>
        <small>Solar Energy Systems &amp; Components</small>
      </span>
    </a>

    <button
      class="hdr__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="hdr__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav id="primary-nav" class="hdr__nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={base + item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary btn--sm hdr__cta" href={base + '/contact'}>Request a Quote</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .hdr[data-stuck] { box-shadow: var(--shadow-md); }

  /* Utility strip — carries the contact details the original header showed */
  .hdr__util {
    background: var(--brand-950);
    color: #AEB7DE;
    font-size: 0.8rem;
  }
  .hdr__util-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.6rem;
    min-height: 40px;
    padding-block: 0.4rem;
  }
  .hdr__util a,
  .hdr__loc {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .hdr__util a:hover { color: var(--gold-300); }
  .hdr__util svg { width: 13px; height: 13px; flex: none; color: var(--gold-500); }
  .hdr__loc { margin-left: auto; }

  .hdr__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 78px;
    padding-block: 0.6rem;
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    text-decoration: none;
    color: var(--ink);
  }
  .hdr__brand img { width: 52px; height: 52px; object-fit: contain; }
  .hdr__brand span { display: grid; line-height: 1.15; }
  .hdr__brand strong {
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--brand-700);
  }
  .hdr__brand small {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hdr__nav { display: flex; align-items: center; gap: 1.6rem; }
  .hdr__nav ul {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hdr__nav ul a {
    position: relative;
    display: block;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.18s var(--ease), background-color 0.18s var(--ease);
  }
  .hdr__nav ul a:hover { color: var(--brand-600); background: var(--brand-50); }
  .hdr__nav ul a[aria-current='page'] { color: var(--brand-600); }
  .hdr__nav ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--gold-500);
  }

  .hdr__toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    cursor: pointer;
  }
  .hdr__bars { display: grid; gap: 4px; justify-items: center; }
  .hdr__bars i {
    display: block;
    width: 19px;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-700);
    transition: transform 0.22s var(--ease), opacity 0.18s var(--ease);
  }
  .hdr__toggle[aria-expanded='true'] i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hdr__toggle[aria-expanded='true'] i:nth-child(2) { opacity: 0; }
  .hdr__toggle[aria-expanded='true'] i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 900px) {
    .hdr__loc { display: none; }
    .hdr__toggle { display: grid; place-items: center; }
    .hdr__nav {
      position: absolute;
      inset: 100% 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0.4rem;
      padding: 1rem var(--gutter) 1.5rem;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
      display: none;
    }
    .hdr__nav[data-open] { display: flex; }
    .hdr__nav ul { flex-direction: column; align-items: stretch; gap: 0.1rem; }
    .hdr__nav ul a { padding: 0.8rem 0.9rem; font-size: 1rem; }
    .hdr__nav ul a[aria-current='page']::after { display: none; }
    .hdr__nav ul a[aria-current='page'] { background: var(--brand-50); }
    .hdr__cta { margin-top: 0.6rem; }
  }

  @media (max-width: 460px) {
    /* Keep the brand lock-up on one line on small phones. */
    .hdr__brand small { display: none; }
    .hdr__brand img { width: 44px; height: 44px; }
    .hdr__util-in { justify-content: center; gap: 0.2rem 1rem; font-size: 0.74rem; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.getElementById('primary-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.toggleAttribute('data-open', !open);
  });

  // Close the mobile menu when a link is followed or Escape is pressed.
  menu?.addEventListener('click', (e) => {
    if (e.target instanceof HTMLAnchorElement) {
      toggle?.setAttribute('aria-expanded', 'false');
      menu.removeAttribute('data-open');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.hasAttribute('data-open')) {
      toggle?.setAttribute('aria-expanded', 'false');
      menu.removeAttribute('data-open');
      toggle?.focus();
    }
  });

  const onScroll = () => header?.toggleAttribute('data-stuck', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
