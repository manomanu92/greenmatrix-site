---
const { title, lead, image = '/img/plant.jpg' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="phero">
  <img class="phero__bg" src={base + image} alt="" width="1800" height="1201" fetchpriority="high" />
  <div class="wrap phero__in">
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
  </div>
</section>

<style>
  .phero { position: relative; isolation: isolate; color: #fff; }
  .phero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(12, 18, 64, 0.95) 15%, rgba(26, 38, 121, 0.78) 100%);
  }
  .phero__in { padding-block: clamp(3.5rem, 9vw, 6rem); }
  .phero h1 { margin: 0; color: #fff; max-width: 20ch; }
  .phero h1::after {
    content: '';
    display: block;
    width: 70px;
    height: 4px;
    margin-top: 1.1rem;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--red-500) 0 40%, var(--gold-500) 40% 100%);
  }
  .phero p {
    max-width: 60ch;
    margin: 1.3rem 0 0;
    font-size: var(--step-1);
    color: rgba(255, 255, 255, 0.88);
  }
</style>
