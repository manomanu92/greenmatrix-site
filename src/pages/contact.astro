---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, whatsappHref } from '../data/site.js';
---

<Base
  title="Contact Us"
  description="Get in touch with Green Matrix in Dubai, UAE — phone +971 55 804 7101, contact@greenmatrixsolar.com. Your trusted partner for solar components across the MENA region."
>
  <PageHero
    title="Contact Us"
    lead="Looking for the best solar components for your next project?"
    image="/img/hero.jpg"
  />

  <section class="section">
    <div class="wrap contact">
      <!-- Details -->
      <div data-reveal>
        <p class="eyebrow">Get in Touch</p>
        <h2>We’d love to hear about your project</h2>
        <p class="lead">
          <strong>Green Matrix</strong> is your trusted partner. Contact us today to find out
          how we can help you harness the Sun’s power.
        </p>

        <ul class="details">
          <li>
            <span class="details__icon">
              <svg viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M172.268 501.67C26.97 291.031 0 269.413 0 192 0 85.961 85.961 0 192 0s192 85.961 192 192c0 77.413-26.97 99.031-172.268 309.67-9.535 13.774-29.93 13.773-39.464 0zM192 272c44.183 0 80-35.817 80-80s-35.817-80-80-80-80 35.817-80 80 35.817 80 80 80z"/></svg>
            </span>
            <div>
              <h3>Office Location</h3>
              <p>{site.address}</p>
            </div>
          </li>
          <li>
            <span class="details__icon">
              <svg viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"/></svg>
            </span>
            <div>
              <h3>Email</h3>
              <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
            </div>
          </li>
          <li>
            <span class="details__icon">
              <svg viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"/></svg>
            </span>
            <div>
              <h3>Phone</h3>
              <p><a href={site.phoneHref}>{site.phone}</a></p>
            </div>
          </li>
        </ul>

        <a class="wa-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          <span class="wa-cta__icon">
            <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C8.84 3 3 8.84 3 16.04c0 2.3.6 4.54 1.75 6.52L3 29l6.6-1.73a13 13 0 0 0 6.44 1.68h.01c7.2 0 13.04-5.84 13.04-13.04C29.09 8.84 23.24 3 16.04 3Zm0 23.74h-.01a10.8 10.8 0 0 1-5.5-1.51l-.4-.23-4.08 1.07 1.09-3.98-.26-.41a10.76 10.76 0 0 1-1.65-5.74c0-5.98 4.87-10.84 10.85-10.84 2.9 0 5.62 1.13 7.67 3.18a10.76 10.76 0 0 1 3.17 7.67c0 5.98-4.86 10.79-10.88 10.79Zm5.95-8.08c-.33-.16-1.93-.95-2.23-1.06-.3-.11-.52-.16-.73.17-.22.32-.84 1.05-1.03 1.27-.19.22-.38.24-.7.08-.33-.16-1.38-.51-2.63-1.62-.97-.87-1.63-1.93-1.82-2.26-.19-.33-.02-.5.14-.67.15-.15.33-.38.49-.58.17-.19.22-.33.33-.55.11-.22.06-.41-.03-.57-.08-.16-.73-1.76-1-2.41-.26-.63-.53-.55-.73-.56l-.62-.01c-.22 0-.57.08-.86.41-.3.33-1.13 1.1-1.13 2.69s1.16 3.12 1.32 3.33c.16.22 2.28 3.48 5.52 4.88.77.33 1.37.53 1.84.68.78.25 1.48.21 2.04.13.62-.09 1.93-.79 2.2-1.55.27-.76.27-1.42.19-1.55-.08-.14-.3-.22-.62-.38Z"/></svg>
          </span>
          <div>
            <strong>Message us on WhatsApp</strong>
            <span>Usually the fastest way to reach us</span>
          </div>
          <svg class="wa-cta__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>

        <div class="follow">
          <h3>Follow Us On</h3>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
          </a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C8.84 3 3 8.84 3 16.04c0 2.3.6 4.54 1.75 6.52L3 29l6.6-1.73a13 13 0 0 0 6.44 1.68h.01c7.2 0 13.04-5.84 13.04-13.04C29.09 8.84 23.24 3 16.04 3Zm0 23.74h-.01a10.8 10.8 0 0 1-5.5-1.51l-.4-.23-4.08 1.07 1.09-3.98-.26-.41a10.76 10.76 0 0 1-1.65-5.74c0-5.98 4.87-10.84 10.85-10.84 2.9 0 5.62 1.13 7.67 3.18a10.76 10.76 0 0 1 3.17 7.67c0 5.98-4.86 10.79-10.88 10.79Zm5.95-8.08c-.33-.16-1.93-.95-2.23-1.06-.3-.11-.52-.16-.73.17-.22.32-.84 1.05-1.03 1.27-.19.22-.38.24-.7.08-.33-.16-1.38-.51-2.63-1.62-.97-.87-1.63-1.93-1.82-2.26-.19-.33-.02-.5.14-.67.15-.15.33-.38.49-.58.17-.19.22-.33.33-.55.11-.22.06-.41-.03-.57-.08-.16-.73-1.76-1-2.41-.26-.63-.53-.55-.73-.56l-.62-.01c-.22 0-.57.08-.86.41-.3.33-1.13 1.1-1.13 2.69s1.16 3.12 1.32 3.33c.16.22 2.28 3.48 5.52 4.88.77.33 1.37.53 1.84.68.78.25 1.48.21 2.04.13.62-.09 1.93-.79 2.2-1.55.27-.76.27-1.42.19-1.55-.08-.14-.3-.22-.62-.38Z"/></svg>
          </a>
        </div>
      </div>

      <!-- Form -->
      <div data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="map" aria-label="Map of Dubai">
    <iframe
      src="https://maps.google.com/maps?q=dubai&t=m&z=12&output=embed&iwloc=near"
      title="Dubai"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 880px) { .contact { grid-template-columns: 1fr; } }

  .details {
    margin: 2.2rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.1rem;
  }
  .details li {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.05rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .details__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--brand-600);
    color: #fff;
  }
  .details__icon svg { width: 18px; height: 18px; }
  .details h3 {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .details p { margin: 0.1rem 0 0; font-weight: 600; color: var(--ink); }
  .details a { color: var(--brand-700); text-decoration: none; }
  .details a:hover { text-decoration: underline; }

  /* WhatsApp call-to-action */
  .wa-cta {
    display: grid;
    grid-template-columns: 46px 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-top: 1.1rem;
    padding: 1.05rem 1.2rem;
    border: 1.5px solid #B8EBCB;
    border-radius: var(--radius-sm);
    background: #F1FBF5;
    text-decoration: none;
    transition: border-color 0.18s var(--ease), background-color 0.18s var(--ease),
                transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .wa-cta:hover {
    border-color: #25D366;
    background: #E7F9EE;
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .wa-cta__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #25D366;
    color: #fff;
  }
  .wa-cta__icon svg { width: 24px; height: 24px; }
  .wa-cta strong { display: block; color: var(--ink); font-size: 1rem; }
  .wa-cta span { font-size: var(--step--1); color: var(--body); }
  .wa-cta__arrow { width: 18px; height: 18px; color: #1A9E4B; }

  .follow { margin-top: 2.2rem; }
  .follow h3 { font-size: 0.95rem; margin-bottom: 0.8rem; }
  .follow a + a { margin-left: 0.6rem; }
  .follow a {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--line);
    border-radius: 50%;
    color: var(--brand-700);
    transition: background-color 0.18s var(--ease), border-color 0.18s var(--ease),
                color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .follow a svg { width: 19px; height: 19px; }
  .follow a:hover {
    background: var(--brand-600);
    border-color: var(--brand-600);
    color: #fff;
    transform: translateY(-2px);
  }

  .map { line-height: 0; border-top: 1px solid var(--line); }
  .map iframe { width: 100%; height: clamp(300px, 42vw, 440px); border: 0; filter: saturate(0.9); }
</style>
