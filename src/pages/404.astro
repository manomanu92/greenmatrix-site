---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page not found" description="The page you were looking for could not be found.">
  <section class="nf">
    <div class="wrap">
      <p class="nf__code">404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lead">The link may be out of date. Try one of these instead.</p>
      <div class="nf__btns">
        <a class="btn btn--primary" href={base + '/'}>Back to home</a>
        <a class="btn btn--outline" href={base + '/products'}>Browse products</a>
        <a class="btn btn--outline" href={base + '/contact'}>Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(4rem, 12vw, 8rem); text-align: center; }
  .nf__code {
    margin: 0 0 0.5rem;
    font-size: clamp(4rem, 14vw, 7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--brand-100);
  }
  .nf .lead { max-width: 46ch; margin-inline: auto; }
  .nf__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 2rem; }
</style>
