# Copy this file to `.env` for local development, and set the same values as
# repository *variables* (Settings → Secrets and variables → Actions) so the
# GitHub Actions build picks them up.

# The Google Apps Script web app that writes enquiries to the Google Sheet and
# emails a notification. Deploy google-apps-script/Code.gs and paste its /exec
# URL here — see google-apps-script/README.md for the walkthrough.
#
# Leave it empty and the form falls back to opening the visitor's mail client,
# so an enquiry is never silently dropped.
PUBLIC_FORM_ENDPOINT=

# Optional. Must match the SHARED_SECRET script property on the Apps Script
# project. Deters drive-by spam; it is visible in the page source, so it is not
# real authentication.
PUBLIC_FORM_TOKEN=
